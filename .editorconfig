root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# google-java-format uses 2 spaces and a 100-column limit (ADR-0019).
[*.java]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[{mvnw.cmd,*.bat,*.cmd}]
end_of_line = crlf
