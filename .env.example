# Copy this file to .env (git-ignored) and adjust the values.
# Both docker compose and the Kaizent application read .env from the repository root.
# Never commit .env.

# Gemini API key for the gemini-api LLM adapter (a free tier is available in Google AI
# Studio). Optional: without it the application starts, and runs fail with a clear message.
GEMINI_API_KEY=

# PostgreSQL credentials, used by compose.yaml and by the application.
# KAIZENT_DB_USER is optional (default: kaizent).
# KAIZENT_DB_PASSWORD is required: choose any password for your local database.
# KAIZENT_DB_USER=kaizent
KAIZENT_DB_PASSWORD=
