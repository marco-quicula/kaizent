# Copy this file to .env (git-ignored) and adjust the values.
# Both docker compose and the Kaizent application read .env from the repository root.
# Never commit .env.

# Gemini API key for the gemini-api LLM adapter (a free tier is available in Google AI
# Studio). Optional: without it the application starts, and runs fail with a clear message.
GEMINI_API_KEY=

# Optional: other model providers (spec 0004). Each adapter is configured only when its key
# or URL is set; select it per step with KAIZENT_LLM_RESOLUTION_ADAPTER (openai, anthropic,
# ollama) and a model of that provider in KAIZENT_LLM_RESOLUTION_MODEL.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: the adapter and model of the resolution step. Defaults: gemini-api and
# gemini-3.6-flash. The fake adapter returns a scripted reply and needs no model or network.
# KAIZENT_LLM_RESOLUTION_ADAPTER=fake
# KAIZENT_LLM_RESOLUTION_MODEL=gemini-2.5-flash

# PostgreSQL credentials, used by compose.yaml and by the application.
# KAIZENT_DB_USER is optional (default: kaizent).
# KAIZENT_DB_PASSWORD is required: choose any password for your local database.
# KAIZENT_DB_USER=kaizent
KAIZENT_DB_PASSWORD=
